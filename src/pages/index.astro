---
import Highlight from "@/components/Highlight.astro";
import Margin from "@/components/Margin.astro";
import MarginNote from "@/components/MarginNote.astro";
import NoteRef from "@/components/NoteRef.astro";
import Ticket from "@/components/Ticket.astro";
import Base from "@/layouts/Base.astro";

// Static defaults; the ticket Worker (phase 6) will refresh these.
const ticketRows = [
  { label: "Brewing", value: "[bean · method]", field: "brewing" },
  { label: "Playing", value: "[game]", field: "playing" },
  { label: "Building", value: "[project]", field: "building" },
  { label: "Reading", value: "[book]", field: "reading" },
  { label: "Last push", value: "akalp/[repo] · [2h] ago", field: "lastPush" },
];
---

<Base footer="full">
  <section class="hero">
    <Margin offset="150px">
      <p class="eyebrow hero__place">Ankara · UTC+3</p>
      <h1 class="hero__title">Hi, I’m Hasan.</h1>
      <p class="hero__lede">
        I write software in Ankara — mostly <Highlight>small tools</Highlight>
        <NoteRef n={1} /> that make my own days a little smoother, and sometimes{" "}
        <Highlight>larger systems</Highlight>
        <NoteRef n={2} /> for other people. Off the keyboard I’m usually{" "}
        <Highlight>brewing coffee</Highlight>
        <NoteRef n={3} />, losing a strategy game far too late at night, or
        trying to make a better <Highlight>burger</Highlight>
        <NoteRef n={4} /> than last week’s.
      </p>
      <Fragment slot="notes">
        <MarginNote n={1} tilt={-1.5}>
          ws, caff, SlidePlay… they live a bit further down ↓
        </MarginNote>
        <MarginNote n={2} tilt={0.8}>
          defense, livestreaming, a few startups. the long version is on{" "}
          <a href="/about">/about</a>
        </MarginNote>
        <MarginNote n={3} tilt={-0.6}>
          today’s beans are on the ticket →
        </MarginNote>
        <MarginNote n={4} tilt={1.2}>
          still iterating. it’s basically a side project.
        </MarginNote>
      </Fragment>
    </Margin>
  </section>

  <div class="ticket-demo">
    <Ticket
      title="Today’s ticket"
      meta="thu · 05 nov · 14:12"
      rows={ticketRows}
      footer={["no. 0412", "thanks for stopping by"]}
    />
    <MarginNote class="ticket-demo__note">
      printed fresh by a tiny worker, every hour
    </MarginNote>
  </div>
</Base>

<style>
  .hero {
    padding: 88px 0 96px;
  }

  .hero :global(.margin-row) {
    gap: 40px 64px;
  }

  .hero__place {
    margin-bottom: 28px;
  }

  .hero__title {
    margin-bottom: 32px;
    font-size: var(--text-h1);
    font-weight: 350;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .hero__lede {
    max-width: 780px;
    font-size: var(--text-lede);
    font-weight: 300;
    line-height: 1.42;
    text-wrap: pretty;
  }

  .hero :global(.margin-note) {
    font-size: 19px;
  }

  .ticket-demo {
    display: flex;
    flex-direction: column;
    gap: 14px;
    max-width: 360px;
    margin: 0 0 112px auto;
  }

  .ticket-demo__note {
    padding-left: 8px;
  }

  .ticket-demo__note :global(.margin-note) {
    font-size: 17px;
  }
</style>
